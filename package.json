{
  "name": "nucleo-matcher-wasm",
  "version": "0.4.0",
  "description": "Fast fuzzy finder, powered by nucleo-matcher compiled to WebAssembly",
  "author": "Jan T. Sott",
  "license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/nucleo-matcher-wasm.git"
	},
  "keywords": [
    "fuzzy matching",
    "fuzzy search",
    "fuzzy finder",
    "fzf",
    "skim",
    "nucleo-matcher"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/nucleo_wasm.d.ts",
      "require": "./dist/nucleo_wasm.cjs",
      "import": "./dist/nucleo_wasm.mjs"
    }
  },
  "sideEffects": [
    "./dist/nucleo_wasm.mjs",
    "./dist/nucleo_wasm.cjs"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "bench": "cd benchmark && pnpm install && node index.ts",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "vite-plugin-wasm": "^3.0.0",
    "vitest": "^4.1.5",
    "zx": "8.8.5-lite"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
