{
  "name": "nucleo-matcher-wasm",
  "version": "0.2.1",
  "description": "Fast fuzzy finder, powered by nucleo-matcher compiled to WebAssembly",
  "author": "Jan T. Sott",
  "license": "MPL-2.0",
  "keywords": [
    "fuzzy matching",
    "fuzzy search",
    "fuzzy finder",
    "fzf",
    "skim",
    "nucleo-matcher"
  ],
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "main": "dist/cjs/nucleo_wasm.js",
  "types": "dist/esm/nucleo_wasm.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/nucleo_wasm.js",
      "import": "./dist/esm/nucleo_wasm.js",
      "types": "./dist/esm/nucleo_wasm.d.ts"
    }
  },
  "sideEffects": [
    "./dist/esm/nucleo_wasm.js",
    "./dist/cjs/nucleo_wasm.js"
  ],
  "scripts": {
    "build": "concurrently \"npm run build:esm\" \"npm run build:cjs\"",
    "build:esm": "wasm-pack build --no-pack --out-dir dist/esm --release",
    "build:cjs": "wasm-pack build --no-pack --out-dir dist/cjs --target nodejs --release",
    "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "bench": "cd benchmark && pnpm install && node index.ts",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite-plugin-wasm": "^3.0.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
