{
  "name": "nucleo-matcher-wasm",
  "version": "0.4.2",
  "description": "Fast fuzzy finder, powered by nucleo-matcher compiled to WebAssembly",
  "author": "Jan T. Sott",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idleberg/nucleo-matcher-wasm.git"
  },
  "keywords": [
    "fuzzy matching",
    "fuzzy search",
    "fuzzy finder",
    "fzf",
    "skim",
    "nucleo-matcher"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/nucleo_wasm.d.ts",
      "require": "./dist/nucleo_wasm.cjs",
      "import": "./dist/nucleo_wasm.mjs"
    }
  },
  "sideEffects": [
    "./dist/nucleo_wasm.mjs",
    "./dist/nucleo_wasm.cjs"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "bench": "node benchmark/index.ts",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "vite-plugin-wasm": "^3.0.0",
    "vitest": "^4.1.10",
    "zx": "8.8.5"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
