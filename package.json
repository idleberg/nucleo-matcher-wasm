{
  "name": "nucleo-matcher-wasm",
  "version": "0.3.1",
  "description": "Fast fuzzy finder, powered by nucleo-matcher compiled to WebAssembly",
  "author": "Jan T. Sott",
  "license": "MPL-2.0",
  "keywords": [
    "fuzzy matching",
    "fuzzy search",
    "fuzzy finder",
    "fzf",
    "skim",
    "nucleo-matcher"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/nucleo_wasm.cjs",
  "types": "dist/nucleo_wasm.d.ts",
  "exports": {
    ".": {
      "require": "./dist/nucleo_wasm.cjs",
      "import": "./dist/nucleo_wasm.mjs",
      "types": "./dist/nucleo_wasm.d.ts"
    }
  },
  "sideEffects": [
    "./dist/nucleo_wasm.mjs",
    "./dist/nucleo_wasm.cjs"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "bench": "cd benchmark && pnpm install && node index.ts",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "vite-plugin-wasm": "^3.0.0",
    "vitest": "^4.1.4",
    "zx": "8.8.5-lite"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
